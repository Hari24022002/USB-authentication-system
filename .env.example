# Copy these values into your PowerShell environment before running app.py.
USB_APP_SECRET=replace-with-a-long-random-secret
USB_AUTH_PASSWORD=replace-with-your-local-app-password

# Comma-separated volume serials (hexadecimal, with or without the 0x prefix).
# Leave empty on the first run; connect a USB and read its serial from the local
# status page/log, then set the serial here and restart the app.
USB_ALLOWED_SERIALS=
